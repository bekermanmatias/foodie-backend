{
  "name": "foodie-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "test:floor-plans": "npm run build && node --test test/floor-plans-layout.test.js",
    "start": "node dist/main.js",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "prisma:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "prisma:status": "prisma migrate status --schema prisma/schema.prisma",
    "backup:production": "bash scripts/backup-production.sh",
    "deploy:production": "bash scripts/deploy-production.sh",
    "rollback:production": "bash scripts/rollback-production.sh"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1128.0",
    "@aws-sdk/s3-request-presigner": "^3.1128.0",
    "@nestjs/common": "^10.4.22",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.22",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.22",
    "@prisma/client": "^5.22.0",
    "@types/pdfkit": "^0.17.6",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "pdfkit": "^0.20.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.22",
    "@types/node": "^22.15.30",
    "prisma": "^5.22.0",
    "typescript": "^5.8.3"
  }
}
